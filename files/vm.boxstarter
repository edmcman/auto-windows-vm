# Load variables
. e:\vars.ps1

# Prevent system sleep helper (SetThreadExecutionState P/Invoke)
Add-Type -TypeDefinition 'using System; using System.Runtime.InteropServices; public static class S{[DllImport("kernel32.dll")] public static extern System.UInt32 SetThreadExecutionState(System.UInt32 esFlags);}'

# Prevent sleep
[void][S]::SetThreadExecutionState([uint32]::Parse("80000003", [System.Globalization.NumberStyles]::HexNumber))

if ($BoxstarterArgs -eq $null) {
    Write-BoxstarterArgs "Expected to find BoxstarterArgs in vars.ps1"
    throw "Expected to find BoxstarterArgs in vars.ps1"
}

# XXX: Maybe VMPACKAGE should also be parsed here?

# Parse $BoxstarterArgs
$params = Invoke-Expression @"
& {
  param(
    [switch]`$EnableSSH
  )
  `$PSBoundParameters
} $BoxstarterArgs
"@

# Put each argument in the global scope
foreach ($k in $params.Keys) {
    Set-Variable -Name $k -Value $params[$k] -Scope Global
}

Function Install-Packages {
    # VM

    try {
        if ($null -ne $VMPACKAGE -and $VMPACKAGE -ne '') {
            Write-BoxstarterMessage "Installing VMPACKAGE: $VMPACKAGE"
            choco install $VMPACKAGE
        }
    } catch {
        Write-BoxstarterMessage "Warning: Failed install $VMPACKAGE. Error: $($_.Exception.Message)"
    }

    # Development

    choco install vscode
    choco install git
    choco install cmake

    # visual studio 2022 with c++
    choco install visualstudio2022community --package-parameters "'--add Microsoft.VisualStudio.Workload.NativeDesktop --includeRecommended'"

    # Windows SDK for windbg
    choco install windows-sdk-10.1

    # Browsers

    choco install googlechrome
    # Utilities

    choco install windirstat
    # sysinternals package often lags
    choco install sysinternals --ignore-checksums

    # Productivity

    # Didn't work?
    #choco install office365business --params "'/exclude:Access Groove Lync OneDrive OneNote Outlook Publisher /language:en-US /eula:FALSE'"
}

Function Apply-Settings {

    Set-StartScreenOptions -EnableBootToDesktop
    Set-WindowsExplorerOptions `
        -EnableShowHiddenFilesFoldersDrives `
        -EnableShowProtectedOSFiles `
        -EnableShowFileExtensions `
        -EnableShowFullPathInTitleBar `
        -EnableOpenFileExplorerToQuickAccess `
        -EnableShowRecentFilesInQuickAccess `
        -EnableShowFrequentFoldersInQuickAccess `
        -EnableExpandToOpenFolder `
        -EnableShowRibbon

    # Move start button to the bottom left
    Set-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" -Name "TaskbarAl" -Value 0

    # Set system theme to dark
    Set-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" -Name "AppsUseLightTheme" -Value 0

    # Set app theme to dark
    Set-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" -Name "SystemUsesLightTheme" -Value 0

    # Enable verbose boot status
    Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" -Name "VerboseStatus" -Value 1 -Type DWord

    # Don't require login after sleep
    # https://learn.microsoft.com/en-us/windows/client-management/mdm/policy-csp-power
    $TmpPath = "HKLM:\Software\Policies\Microsoft\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51"
    New-Item -Path "HKLM:\SOFTWARE\Policies\Microsoft\Power\PowerSettings" -Name "0e796bdb-100d-47d6-a2d5-f7d2daa51f51" -Force
    Set-ItemProperty -Path "$TmpPath" -Name "ACSettingIndex" -Value 0 -Type DWord
    Set-ItemProperty -Path "$TmpPath" -Name "DCSettingIndex" -Value 0 -Type DWord

    # Use Detailed Task Manager view
    # https://superuser.com/a/1629094/130232
    Set-ItemProperty -Path "HKLM:Software\Microsoft\Windows\CurrentVersion\TaskManager" -Name "StartUpTab" -Value 5 -Type DWord
}

Function Install-SSH {
    dism /online /add-capability /capabilityname:OpenSSH.Server
    Set-Service sshd -StartupType Automatic

    # Adjust the config so admin users can use their own authorized_keys file.
    $cfg = "C:\ProgramData\ssh\sshd_config"
    Copy-Item $cfg "$cfg.bak" -Force
    (Get-Content $cfg) `
        -replace '^\s*Match\s+Group\s+administrators\b', 'Match Group disabled' |
        Set-Content $cfg -Encoding ascii

    Start-Service sshd

    $sshFirewallRuleName = "Allow-SSHD-Inbound-22-PrivatePublic"
    if (-not (Get-NetFirewallRule -Name $sshFirewallRuleName -ErrorAction SilentlyContinue)) {
        New-NetFirewallRule `
            -Name $sshFirewallRuleName `
            -DisplayName "Allow SSH (TCP 22) for Packer" `
            -Direction Inbound `
            -Action Allow `
            -Protocol TCP `
            -LocalPort 22 `
            -Profile @("Private", "Public")
    }
}

Apply-Settings

Install-Packages

# Install and enable OpenSSH Server if requested
if ($EnableSSH) {
    Write-BoxstarterMessage "Installing and enabling OpenSSH Server"
    try {
        Install-SSH
    } catch {
        Write-BoxstarterMessage "Warning: Failed to install or enable OpenSSH Server. Error: $($_.Exception.Message)"
    }
}

# Updates

Write-BoxstarterMessage "Enabling Microsoft Update"

Enable-MicrosoftUpdate

Write-BoxstarterMessage "Installing Updates"

Boxstarter.WinConfig\Install-WindowsUpdate

# Remove page file
# Source: https://github.com/mwrock/packer-templates/blob/master/scripts/package.ps1

Write-BoxstarterMessage "Removing page file"
$pageFileMemoryKey = "HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management"
Set-ItemProperty -Path $pageFileMemoryKey -Name PagingFiles -Value ""

if (Test-PendingReboot) { Invoke-Reboot }

# Enable WinRM to conclude packer provisioning process
e:\enable-winrm.ps1
